# Secrets only. Copy this file to .env and fill in the key for the provider
# set in config/settings.toml. Never commit .env.
# All other configuration is in config/settings.toml.

# Required when model.provider = "oci": an OCI Generative AI API key.
OCI_GENAI_API_KEY=

# Required when model.provider = "openai": an OpenAI API key.
OPENAI_API_KEY=
