# Copy this file to .env and fill in your values. Never commit .env.

# --- Model provider: "oci" (OCI Generative AI) or "openai" -------------------
MODEL_PROVIDER=oci
# An OpenAI GPT model: the OCI model id (for example openai.gpt-...) or the
# OpenAI model name, depending on the provider.
MODEL_ID=

# Required when MODEL_PROVIDER=oci: an OCI Generative AI API key.
OCI_GENAI_API_KEY=
# Required when MODEL_PROVIDER=openai.
OPENAI_API_KEY=

# --- OCI (always required: the sandboxes run on OCI) -------------------------
OCI_REGION=eu-frankfurt-1
# Generative AI project with sandboxes enabled (outbound network: DENY_ALL).
OCI_PROJECT_ID=
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT
# "api_key" or "security_token" (oci session authenticate).
OCI_AUTH=api_key

# --- Sandbox defaults --------------------------------------------------------
SANDBOX_RUNTIME=python-3.11
SANDBOX_SHAPE=SMALL
SANDBOX_LIFETIME_MINUTES=60
# Longest command the application will run, in seconds.
SANDBOX_MAX_COMMAND_SECONDS=300
